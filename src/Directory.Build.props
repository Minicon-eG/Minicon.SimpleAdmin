<Project>

  <!-- Debug-Symbole: PDB direkt in die DLL einbetten und den kompletten
       Quellcode mit in die PDB packen. Dadurch traegt jedes veroeffentlichte
       Paket (nupkg) alles, was zum Debuggen und Quell-Navigieren noetig ist -
       ohne Symbol-Server. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EmbedAllSources>true</EmbedAllSources>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Package metadata shared by all packages (public repository). -->
    <RepositoryUrl>https://github.com/Minicon-eG/Minicon.SimpleAdmin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Minicon-eG/Minicon.SimpleAdmin</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Kein separates Symbol-Paket noetig - die PDB steckt in der DLL. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Deterministische Build-Pfade im CI-Lauf (GitHub Actions). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- README/LICENSE liegen im Repo eine Ebene hoeher, im entpackten Quellcode
       (SimpleAdmin.Sources/) neben dieser Datei. -->
  <PropertyGroup>
    <_SimpleAdminRepoRoot Condition="Exists('$(MSBuildThisFileDirectory)../README.md')">$(MSBuildThisFileDirectory)../</_SimpleAdminRepoRoot>
    <_SimpleAdminRepoRoot Condition="'$(_SimpleAdminRepoRoot)' == ''">$(MSBuildThisFileDirectory)</_SimpleAdminRepoRoot>
    <_SimpleAdminIsPackage Condition="'$(MSBuildProjectName)' != 'Minicon.SimpleAdmin.Tests'">true</_SimpleAdminIsPackage>
  </PropertyGroup>

  <!-- README shown on nuget.org for every package. -->
  <ItemGroup Condition="'$(_SimpleAdminIsPackage)' == 'true' And Exists('$(_SimpleAdminRepoRoot)README.md')">
    <None Include="$(_SimpleAdminRepoRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Quellcode im Paket mitliefern: "sources/" enthaelt das Projekt (ohne bin/obj),
       "sources-root/" die gemeinsamen Dateien (diese Datei, build/, README, LICENSE).
       buildTransitive/<PackageId>.targets entpackt beides beim Build des Hosts nach
       SimpleAdmin.Sources/ (siehe build/Minicon.SimpleAdmin.Sources.targets). -->
  <ItemGroup Condition="'$(_SimpleAdminIsPackage)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)build/Minicon.SimpleAdmin.Sources.targets"
          Pack="true" PackagePath="buildTransitive/$(PackageId).targets" Visible="false" />
    <None Include="$(MSBuildThisFileFullPath)" Pack="true" PackagePath="sources-root/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)build/Minicon.SimpleAdmin.Sources.targets" Pack="true" PackagePath="sources-root/build/" Visible="false" />
    <None Include="$(_SimpleAdminRepoRoot)README.md" Pack="true" PackagePath="sources-root/" Visible="false" Condition="Exists('$(_SimpleAdminRepoRoot)README.md')" />
    <None Include="$(_SimpleAdminRepoRoot)LICENSE" Pack="true" PackagePath="sources-root/" Visible="false" Condition="Exists('$(_SimpleAdminRepoRoot)LICENSE')" />
    <None Include="$(_SimpleAdminRepoRoot)CHANGELOG.md" Pack="true" PackagePath="sources-root/" Visible="false" Condition="Exists('$(_SimpleAdminRepoRoot)CHANGELOG.md')" />
  </ItemGroup>

  <!-- Die Projektdateien erst beim Packen anhaengen: als None-Items im Projekt
       wuerden sie z. B. den Razor-Compiler (scoped CSS) durcheinanderbringen.
       Gepackt wird eine Kopie unter obj/, weil NuGet Dateien ausschliesst, die als
       Content mit Pack=false markiert sind (Razor macht das fuer alle .cshtml). -->
  <PropertyGroup Condition="'$(_SimpleAdminIsPackage)' == 'true'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SimpleAdminPackSources</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_SimpleAdminPackSources">
    <ItemGroup>
      <_SimpleAdminPackSource Include="$(MSBuildProjectDirectory)/**/*"
                              Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/**/*.user;$(MSBuildProjectDirectory)/**/.DS_Store" />
    </ItemGroup>
    <PropertyGroup>
      <_SimpleAdminPackSourceDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'simpleadmin-sources'))</_SimpleAdminPackSourceDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_SimpleAdminPackSourceDir)" />
    <Copy SourceFiles="@(_SimpleAdminPackSource)"
          DestinationFiles="@(_SimpleAdminPackSource->'$(_SimpleAdminPackSourceDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <_SimpleAdminPackSourceCopy Include="$(_SimpleAdminPackSourceDir)**/*" />
      <TfmSpecificPackageFile Include="@(_SimpleAdminPackSourceCopy)"
                              PackagePath="sources/" />
    </ItemGroup>
  </Target>

  <!-- Das Worker-Paket liefert zusaetzlich das Testprojekt unter "sources-tests/" mit. Der Host
       entpackt es nur auf Wunsch (SimpleAdminExtractTests=true, siehe
       build/Minicon.SimpleAdmin.Sources.targets). Worker, weil das Testprojekt alle Pakete
       referenziert und der Worker die meisten davon mitbringt. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Minicon.SimpleAdmin.Worker'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SimpleAdminPackTestSources</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_SimpleAdminPackTestSources">
    <PropertyGroup>
      <_SimpleAdminTestsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'Minicon.SimpleAdmin.Tests'))</_SimpleAdminTestsDir>
      <_SimpleAdminPackTestsDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'simpleadmin-tests'))</_SimpleAdminPackTestsDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_SimpleAdminTestsDir)')">
      <_SimpleAdminPackTest Include="$(_SimpleAdminTestsDir)**/*"
                            Exclude="$(_SimpleAdminTestsDir)bin/**;$(_SimpleAdminTestsDir)obj/**;$(_SimpleAdminTestsDir)**/*.user;$(_SimpleAdminTestsDir)**/.DS_Store;$(_SimpleAdminTestsDir)TestResults/**" />
    </ItemGroup>
    <RemoveDir Directories="$(_SimpleAdminPackTestsDir)" />
    <Copy SourceFiles="@(_SimpleAdminPackTest)"
          DestinationFiles="@(_SimpleAdminPackTest->'$(_SimpleAdminPackTestsDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <_SimpleAdminPackTestCopy Include="$(_SimpleAdminPackTestsDir)**/*" />
      <TfmSpecificPackageFile Include="@(_SimpleAdminPackTestCopy)" PackagePath="sources-tests/" />
    </ItemGroup>
  </Target>

  <!-- Expose internal members of every Minicon.SimpleAdmin.* library to the test
       project. The test project itself also picks this up, which is harmless. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Minicon.SimpleAdmin.Tests'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Minicon.SimpleAdmin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
