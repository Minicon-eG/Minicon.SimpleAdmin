<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Minicon.SimpleAdmin</RootNamespace>
    <AssemblyName>Minicon.SimpleAdmin.Shared</AssemblyName>
    <PackageId>Minicon.SimpleAdmin.Shared</PackageId>
    <Version>2.30.0</Version>
    <Authors>Minicon Contributors</Authors>
    <Description>Core models, services, and DTOs for the Minicon SimpleAdmin monitoring platform.</Description>
    <PackageTags>monitoring;simpleadmin;models;status</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
