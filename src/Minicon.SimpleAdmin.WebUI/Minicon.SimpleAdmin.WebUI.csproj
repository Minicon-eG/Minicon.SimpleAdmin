<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RootNamespace>Minicon.SimpleAdmin.WebUI</RootNamespace>
    <AssemblyName>Minicon.SimpleAdmin.WebUI</AssemblyName>
    <PackageId>Minicon.SimpleAdmin.WebUI</PackageId>
    <Version>2.36.0</Version>
    <Authors>Minicon Contributors</Authors>
    <Description>Razor Class Library providing the full SimpleAdmin admin UI (controllers, views, REST API and services) for the Minicon SimpleAdmin monitoring platform. A host application only needs to call AddSimpleAdminWebUI / UseSimpleAdminWebUI.</Description>
    <PackageTags>monitoring;simpleadmin;webui;mvc;razor-class-library</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Minicon.SimpleAdmin.Shared/Minicon.SimpleAdmin.Shared.csproj" />
    <ProjectReference Include="../Minicon.SimpleAdmin.Services/Minicon.SimpleAdmin.Services.csproj" />
    <ProjectReference Include="../Minicon.SimpleAdmin.Checkers/Minicon.SimpleAdmin.Checkers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit pulls System.Security.Cryptography.Pkcs 10.0.0 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) — pin the patched version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- SimpleAdminWebUIHost: Windows-Dienst-Betrieb. HttpSys ist Teil der ASP.NET-Core-SharedFramework. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- install.cmd neben die Host-EXE kopieren und ins NuGet-Paket packen. -->
    <None Include="install.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\install.cmd;content\install.cmd</PackagePath>
      <BuildAction>Content</BuildAction>
    </None>
  </ItemGroup>

</Project>
