@model Minicon.SimpleAdmin.WebUI.ViewModels.ServerChecksViewModel
@{
    var appPools = Model?.AppPools ?? new Minicon.SimpleAdmin.WebUI.ViewModels.AppPoolChecksViewModel();
}

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-layers me-2"></i>IIS AppPool-Überwachung</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse"
                data-bs-target="#appPoolHelp" aria-expanded="false">
            <i class="bi bi-question-circle me-1"></i>Hilfe
        </button>
    </div>
    <div class="card-body">
        <!-- Hilfe-Bereich (eingeklappt) -->
        <div class="collapse mb-3" id="appPoolHelp">
            <div class="card card-body bg-light">
                <h6><i class="bi bi-info-circle me-1"></i>So funktioniert die AppPool-Überwachung</h6>
                <p class="mb-2">
                    SimpleAdmin kann IIS Application Pools auf diesem Server überwachen und deren Status,
                    Speicherverbrauch sowie Laufzeit prüfen.
                </p>

                <h6 class="mt-3">Was wird geprüft?</h6>
                <ul class="mb-2">
                    <li><strong>Status:</strong> Läuft der Pool? (Running/Stopped/Starting/Stopping)</li>
                    <li><strong>Memory:</strong> RAM-Verbrauch des Worker-Prozesses (w3wp.exe) in MB</li>
                    <li><strong>Uptime:</strong> Zeit seit dem letzten Recycle des Pools</li>
                </ul>

                <h6 class="mt-3">Zwei Modi verfügbar</h6>
                <table class="table table-sm table-bordered mb-2">
                    <thead class="table-light">
                        <tr><th>Modus</th><th>Beschreibung</th><th>Anwendungsfall</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Auto-Discovery</strong></td>
                            <td>Alle Pools automatisch erkennen, ungewünschte per Ignore-Liste ausschließen</td>
                            <td>Empfohlen wenn die meisten Pools überwacht werden sollen</td>
                        </tr>
                        <tr>
                            <td><strong>Manuell</strong></td>
                            <td>Nur explizit angegebene Pools überwachen</td>
                            <td>Wenn nur wenige bestimmte Pools relevant sind</td>
                        </tr>
                    </tbody>
                </table>

                <h6 class="mt-3">Wildcards</h6>
                <p class="mb-2">Wildcards werden in beiden Modi unterstützt – zum Ausschließen (Auto-Discovery) und zum Einschließen (Manuell):</p>
                <ul class="mb-0">
                    <li><code>Test*</code> – Beginnt mit "Test"</li>
                    <li><code>*Test*</code> – Enthält "Test"</li>
                    <li><code>*_Dev</code> – Endet mit "_Dev"</li>
                </ul>
            </div>
        </div>

        <!-- Hauptschalter: AppPool-Überwachung -->
        <div class="form-check form-switch mb-3">
            <input type="checkbox" name="Checks.AppPools.Enabled" value="true"
                   class="form-check-input" id="appPoolsEnabled"
                   @(appPools.Enabled ? "checked" : "") />
            <label class="form-check-label" for="appPoolsEnabled">
                <strong>AppPool-Überwachung aktivieren</strong>
            </label>
            <div class="form-text">
                Aktiviert die Überwachung von IIS Application Pools auf diesem Server.
            </div>
        </div>

        <div id="appPoolsConfig" style="@(appPools.Enabled ? "" : "display: none;")">
            <hr />

            <!-- Modus-Auswahl: Auto-Discovery -->
            <div class="card mb-3 @(appPools.DiscoverAll ? "border-primary" : "")">
                <div class="card-body">
                    <div class="form-check">
                        <input type="checkbox" name="Checks.AppPools.DiscoverAll" value="true"
                               class="form-check-input" id="discoverAllPools"
                               @(appPools.DiscoverAll ? "checked" : "") />
                        <label class="form-check-label" for="discoverAllPools">
                            <strong><i class="bi bi-magic me-1"></i>Automatische Pool-Erkennung (Auto-Discovery)</strong>
                        </label>
                    </div>
                    <div class="mt-2 small text-muted">
                        Erkennt automatisch alle IIS Application Pools auf dem Server.
                        Ungewünschte Pools können über eine Ignore-Liste ausgeschlossen werden.
                    </div>
                </div>
            </div>

            <!-- Auto-Discovery Modus: Ignore-Liste -->
            <div id="autoDiscoverySection" style="@(appPools.DiscoverAll ? "" : "display: none;")">
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">
                            <i class="bi bi-eye-slash me-1"></i>Ignorierte AppPools
                            <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addIgnoredPool()">
                            <i class="bi bi-plus-circle me-1"></i>Hinzufügen
                        </button>
                    </div>
                    <div id="ignoredPools">
                        @for (int i = 0; i < appPools.IgnoredPools.Count; i++)
                        {
                            <div class="input-group mb-2 ignored-pool-item" data-index="@i">
                                <input type="text" class="form-control font-monospace"
                                       name="Checks.AppPools.IgnoredPools[@i]"
                                       value="@appPools.IgnoredPools[i]"
                                       placeholder="z.B. Test* oder *_Dev" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeIgnoredPool(this)"
                                        title="Entfernen">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div id="noIgnoredPools" class="text-muted small @(appPools.IgnoredPools.Count > 0 ? "d-none" : "")">
                        Keine Einträge – alle Pools werden überwacht.
                    </div>
                    <div class="form-text mt-1">
                        Diese Pools werden <strong>nicht</strong> überwacht.
                        Wildcards: <code>Test*</code>, <code>*Test*</code>, <code>*_Dev</code>
                    </div>
                </div>
            </div>

            <!-- Manueller Modus: Pool-Liste -->
            <div id="manualSection" style="@(appPools.DiscoverAll ? "display: none;" : "")">
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Manueller Modus:</strong> Nur die unten angegebenen Pools werden überwacht.
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">
                            <i class="bi bi-list-check me-1"></i>Zu überwachende AppPools
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addManualPool()">
                            <i class="bi bi-plus-circle me-1"></i>Hinzufügen
                        </button>
                    </div>
                    <div id="manualPools">
                        @for (int i = 0; i < appPools.ManualPools.Count; i++)
                        {
                            <div class="input-group mb-2 manual-pool-item" data-index="@i">
                                <input type="text" class="form-control font-monospace"
                                       name="Checks.AppPools.ManualPools[@i]"
                                       value="@appPools.ManualPools[i]"
                                       placeholder="z.B. DefaultAppPool oder ConfigService*" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeManualPool(this)"
                                        title="Entfernen">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <div id="noManualPools" class="text-muted small @(appPools.ManualPools.Count > 0 ? "d-none" : "")">
                        Keine Einträge – es werden keine Pools überwacht.
                    </div>
                    <div id="manualPoolsRequiredError" class="text-danger small mt-2" style="display:none;">
                        Mindestens ein AppPool muss konfiguriert sein wenn die Überwachung aktiv ist.
                    </div>
                    <div class="form-text mt-1">
                        Exakte Namen oder Wildcards: <code>ConfigService*</code>, <code>*AppPool</code>, <code>*Service*</code>
                    </div>
                </div>
            </div>

            <hr />

            <!-- Info Box: Schwellwerte -->
            <div class="alert alert-secondary mb-0">
                <div class="d-flex align-items-start">
                    <i class="bi bi-sliders me-2 mt-1"></i>
                    <div>
                        <strong>Schwellwerte anpassen?</strong><br />
                        <small>
                            Memory-Limits und Uptime-Warnungen werden global konfiguriert unter
                            <a href="/Settings/Features" class="alert-link">Einstellungen → Features → AppPool-Monitoring</a>.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // AppPool-Überwachung aktivieren/deaktivieren
    document.getElementById('appPoolsEnabled')?.addEventListener('change', function() {
        document.getElementById('appPoolsConfig').style.display = this.checked ? '' : 'none';
    });

    // Auto-Discovery: Zwischen Modi wechseln
    document.getElementById('discoverAllPools')?.addEventListener('change', function() {
        const isAutoDiscovery = this.checked;
        document.getElementById('autoDiscoverySection').style.display = isAutoDiscovery ? '' : 'none';
        document.getElementById('manualSection').style.display = isAutoDiscovery ? 'none' : '';
        this.closest('.card').classList.toggle('border-primary', isAutoDiscovery);
    });

    // Validation: manual mode requires at least one pool
    document.querySelector('form')?.addEventListener('submit', function(e) {
        const errorEl = document.getElementById('manualPoolsRequiredError');
        errorEl.style.display = 'none';

        const enabled = document.getElementById('appPoolsEnabled')?.checked;
        const discoverAll = document.getElementById('discoverAllPools')?.checked;
        if (!enabled || discoverAll) return;

        const hasPool = [...document.querySelectorAll('.manual-pool-item input[type="text"]')]
            .some(function(t) { return t.value.trim().length > 0; });
        if (!hasPool) {
            errorEl.style.display = '';
            e.preventDefault();
            errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    // Ignored pools list management
    let ignoredPoolIndex = @appPools.IgnoredPools.Count;

    function addIgnoredPool() {
        const i = ignoredPoolIndex++;
        const html = `<div class="input-group mb-2 ignored-pool-item" data-index="${i}">
            <input type="text" class="form-control font-monospace"
                   name="Checks.AppPools.IgnoredPools[${i}]"
                   placeholder="z.B. Test* oder *_Dev" />
            <button type="button" class="btn btn-outline-danger" onclick="removeIgnoredPool(this)" title="Entfernen">
                <i class="bi bi-trash"></i>
            </button>
        </div>`;
        document.getElementById('ignoredPools').insertAdjacentHTML('beforeend', html);
        document.getElementById('noIgnoredPools').classList.add('d-none');
    }

    function removeIgnoredPool(btn) {
        btn.closest('.ignored-pool-item').remove();
        reindexIgnoredPools();
        if (!document.querySelector('.ignored-pool-item'))
            document.getElementById('noIgnoredPools').classList.remove('d-none');
    }

    function reindexIgnoredPools() {
        document.querySelectorAll('.ignored-pool-item').forEach((item, idx) => {
            item.dataset.index = idx;
            item.querySelectorAll('input').forEach(el => {
                el.name = el.name.replace(/IgnoredPools\[\d+\]/, `IgnoredPools[${idx}]`);
            });
        });
        ignoredPoolIndex = document.querySelectorAll('.ignored-pool-item').length;
    }

    // Manual pools list management
    let manualPoolIndex = @appPools.ManualPools.Count;

    function addManualPool() {
        const i = manualPoolIndex++;
        const html = `<div class="input-group mb-2 manual-pool-item" data-index="${i}">
            <input type="text" class="form-control font-monospace"
                   name="Checks.AppPools.ManualPools[${i}]"
                   placeholder="z.B. DefaultAppPool oder ConfigService*" />
            <button type="button" class="btn btn-outline-danger" onclick="removeManualPool(this)" title="Entfernen">
                <i class="bi bi-trash"></i>
            </button>
        </div>`;
        document.getElementById('manualPools').insertAdjacentHTML('beforeend', html);
        document.getElementById('noManualPools').classList.add('d-none');
    }

    function removeManualPool(btn) {
        btn.closest('.manual-pool-item').remove();
        reindexManualPools();
        if (!document.querySelector('.manual-pool-item'))
            document.getElementById('noManualPools').classList.remove('d-none');
    }

    function reindexManualPools() {
        document.querySelectorAll('.manual-pool-item').forEach((item, idx) => {
            item.dataset.index = idx;
            item.querySelectorAll('input').forEach(el => {
                el.name = el.name.replace(/ManualPools\[\d+\]/, `ManualPools[${idx}]`);
            });
        });
        manualPoolIndex = document.querySelectorAll('.manual-pool-item').length;
    }
</script>
