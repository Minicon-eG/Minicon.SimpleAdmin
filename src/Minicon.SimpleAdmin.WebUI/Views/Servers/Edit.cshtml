@inject Minicon.SimpleAdmin.WebUI.Services.ConfigurationService ConfigService
@model Minicon.SimpleAdmin.WebUI.ViewModels.ServerViewModel
@{
    ViewData["Title"] = "Server bearbeiten";
    var originalName = ViewBag.OriginalName as string;
}

<div class="container-fluid">
    <h1 class="mb-4">
        <i class="bi bi-pencil me-2"></i>Server bearbeiten: @originalName
    </h1>

    <form asp-action="Edit" asp-route-id="@originalName" method="post" id="serverForm">
        @Html.AntiForgeryToken()

        <div class="row">
            <div class="col-lg-8">
                @await Html.PartialAsync("_ServerFormPartial", Model)
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Änderungen speichern
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg me-1"></i>Abbrechen
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ServerFormScriptsPartial" />
}
