@inject Minicon.SimpleAdmin.WebUI.Services.ConfigurationService ConfigService
@inject Minicon.SimpleAdmin.WebUI.Services.Scripts.ScriptRunnerOptions ScriptRunnerOptions
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ConfigService.GetApplicationTitle()</title>
    @* Apply the stored theme (or the OS preference) before the first paint — no light flash in dark mode *@
    <script>
        (function () {
            var theme;
            try { theme = localStorage.getItem('sa-theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/_content/Minicon.SimpleAdmin.WebUI/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/Minicon.SimpleAdmin.WebUI/lib/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Minicon.SimpleAdmin.WebUI/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Minicon.SimpleAdmin.WebUI/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/_content/Minicon.SimpleAdmin.WebUI/css/pages.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top app-nav">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="app-logo"><i class="bi bi-activity"></i></span>@ConfigService.GetApplicationTitle()
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Servers" ? "active" : "")"
                           asp-controller="Servers" asp-action="Index">
                            <i class="bi bi-hdd-stack me-1"></i>Server
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Environments" ? "active" : "")"
                           asp-controller="Environments" asp-action="Index">
                            <i class="bi bi-diagram-3 me-1"></i>Umgebungen
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"
                           asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-sliders me-1"></i>Einstellungen
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Status" ? "active" : "")"
                           asp-controller="Status" asp-action="Index">
                            <i class="bi bi-display me-1"></i>Status
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Problems" ? "active" : "")"
                           asp-controller="Problems" asp-action="Index">
                            <i class="bi bi-exclamation-triangle me-1"></i>Probleme
                            @* Filled by site.js from /api/problems (async, never blocks the page) *@
                            <span class="badge bg-danger nav-count d-none" data-open-problems="@Url.Content("~/api/problems")"
                                  title="Offene (nicht quittierte) Probleme"></span>
                        </a>
                    </li>
                    @if (ScriptRunnerOptions.Enabled)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Scripts" ? "active" : "")"
                               asp-controller="Scripts" asp-action="Index">
                                <i class="bi bi-terminal me-1"></i>Skripte
                            </a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Documentation" ? "active" : "")"
                           asp-controller="Documentation" asp-action="Index">
                            <i class="bi bi-book me-1"></i>Hilfe
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <button type="button" class="btn btn-glass theme-toggle" data-theme-toggle title="Dunkles Design" aria-label="Design umschalten">
                            <i class="bi bi-moon-stars"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid py-4 app-main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer py-3">
        <div class="container-fluid">
            <div class="row">
                <div class="col text-muted small">
                    <i class="bi bi-shield-check me-1"></i>Minicon.SimpleAdmin v@(typeof(Minicon.SimpleAdmin.WebUI.SimpleAdminWebUIExtensions).Assembly.GetName().Version?.ToString(3))
                </div>
                <div class="col text-end text-muted small">
                    <span id="configStatus" class="me-3">
                        @if (ConfigService.IsLoaded)
                        {
                            <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i>
                            <span>Konfiguration geladen (@ConfigService.GetServers().Count Server)</span>
                            @if (ConfigService.HasChanges)
                            {
                                <span class="text-warning ms-2"><i class="bi bi-exclamation-circle me-1"></i>Ungespeicherte Änderungen</span>
                            }
                        }
                        else
                        {
                            <i class="bi bi-circle-fill text-secondary me-1" style="font-size: 0.5rem;"></i>
                            <span>Keine Konfiguration geladen</span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/_content/Minicon.SimpleAdmin.WebUI/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/Minicon.SimpleAdmin.WebUI/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Minicon.SimpleAdmin.WebUI/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
