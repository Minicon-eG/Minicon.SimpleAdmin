@model IEnumerable<Minicon.SimpleAdmin.WebUI.ViewModels.ServerStatusView>
@using Minicon.SimpleAdmin.Models.Status

@{
    ViewData["Title"] = "Status";

    // One card per server (the reader already aggregates all service files of a server).
    var servers = Model.OrderBy(s => s.ServerId, StringComparer.OrdinalIgnoreCase).ToList();
    var tiles = new[]
    {
        ServiceStatus.Unhealthy, ServiceStatus.Unreachable, ServiceStatus.Degraded,
        ServiceStatus.Acknowledged, ServiceStatus.Unknown, ServiceStatus.Healthy
    };

    static string MetricTone(Metric? metric) => metric == null ? "muted" : Display.Tone(metric.Status);
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-4">
    <div>
        <h1 class="mb-1"><i class="bi bi-display me-2"></i>Status</h1>
        <p class="text-body-secondary mb-0">Übersicht über den Zustand aller überwachten Server</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <partial name="_AutoRefresh" />
        <button type="button" class="btn btn-glass" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>Aktualisieren
        </button>
    </div>
</div>

@if (servers.Count > 0)
{
    @* Filter tiles — one per server status; a click filters, a second click resets *@
    <div class="status-tiles mb-3">
        @foreach (var tile in tiles)
        {
            var count = servers.Count(s => s.OverallStatus == tile);
            <button type="button" class="kpi-tile status-filter tone-@Display.Tone(tile)" data-status="@tile"
                    aria-pressed="false" title="Nur Server mit Status „@Display.Label(tile)“ anzeigen">
                <i class="bi @Display.Icon(tile)"></i>
                <span class="kpi-value">@count</span>
                <span class="kpi-label">@Display.Label(tile)</span>
            </button>
        }
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="input-group input-group-sm status-search">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" class="form-control" id="statusSearch" placeholder="Server oder Dienst suchen …" aria-label="Server suchen" />
        </div>
        <small class="text-body-secondary" id="statusSummary"></small>
        <button type="button" class="btn btn-link btn-sm p-0 d-none" id="statusReset">Filter zurücksetzen</button>
    </div>

    <div class="row g-3" id="serverGrid">
        @foreach (var server in servers)
        {
            var tone = Display.Tone(server.OverallStatus);
            var detailsUrl = Url.Action("Details", new { id = server.ServerId });
            var cpu = server.Metrics.FirstOrDefault(m => m.Name == "cpu");
            var memory = server.Metrics.FirstOrDefault(m => m.Name == "memory");
            var openProblems = server.ActiveProblems.Count(p => !p.Acknowledged);
            var searchText = $"{server.ServerId} {string.Join(' ', server.Services.Select(s => s.Service))}".ToLowerInvariant();

            var stoppedPools = server.AppPools?.Values.Count(p => p.Status != Minicon.SimpleAdmin.Models.State.AppPoolStatus.Running) ?? 0;
            var totalPools = server.AppPools?.Count ?? 0;
            var stoppedServices = server.WindowsServices?.Values.Count(s => s.Status != "Running") ?? 0;
            var totalServices = server.WindowsServices?.Count ?? 0;
            var sqlCritical = server.SqlQueryChecks.Values.Count(c => c.Status == Minicon.SimpleAdmin.Models.State.MetricStatus.Critical);
            var sqlTotal = server.SqlQueryChecks.Count;

            <div class="col-md-6 col-xl-4 server-card" data-status="@server.OverallStatus" data-search="@searchText">
                <div class="card h-100 status-card status-card-@tone">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2">
                        <h5 class="mb-0 text-truncate">
                            @* Stretched link: the whole card opens the details, the HTML buttons below stay separate *@
                            <a href="@detailsUrl" class="stretched-link text-reset text-decoration-none">
                                <i class="bi bi-hdd-rack me-2 text-body-secondary"></i>@server.ServerId
                            </a>
                        </h5>
                        <span class="pill pill-@tone"><i class="bi @Display.Icon(server.OverallStatus)"></i>@Display.Label(server.OverallStatus)</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-3 mb-3">
                            <div class="status-metric">
                                <span class="status-metric-label">CPU</span>
                                <span class="pill pill-@MetricTone(cpu)">@(cpu != null ? cpu.Value.ToString("F1") + " %" : "–")</span>
                            </div>
                            <div class="status-metric">
                                <span class="status-metric-label">Arbeitsspeicher</span>
                                <span class="pill pill-@MetricTone(memory)">@(memory != null ? memory.Value.ToString("F1") + " %" : "–")</span>
                            </div>
                            <div class="status-metric">
                                <span class="status-metric-label">Offene Probleme</span>
                                <span class="pill pill-@(openProblems > 0 ? "crit" : "ok")">@openProblems</span>
                            </div>
                        </div>

                        @if (totalPools > 0 || totalServices > 0 || sqlTotal > 0 || server.EventLogs != null)
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @if (totalPools > 0)
                                {
                                    <span class="pill pill-@(stoppedPools > 0 ? "crit" : "ok")" title="Application Pools: @(totalPools - stoppedPools) von @totalPools laufen">
                                        <i class="bi bi-layers"></i>@(totalPools - stoppedPools)/@totalPools Pools
                                    </span>
                                }
                                @if (totalServices > 0)
                                {
                                    <span class="pill pill-@(stoppedServices > 0 ? "crit" : "ok")" title="Windows-Dienste: @(totalServices - stoppedServices) von @totalServices laufen">
                                        <i class="bi bi-window"></i>@(totalServices - stoppedServices)/@totalServices Dienste
                                    </span>
                                }
                                @if (sqlTotal > 0)
                                {
                                    <span class="pill pill-@(sqlCritical > 0 ? "crit" : "ok")" title="SQL-Prüfungen: @(sqlTotal - sqlCritical) von @sqlTotal OK">
                                        <i class="bi bi-database"></i>@(sqlTotal - sqlCritical)/@sqlTotal SQL
                                    </span>
                                }
                                @if (server.EventLogs != null)
                                {
                                    var elTone = server.EventLogs.Status switch
                                    {
                                        Minicon.SimpleAdmin.Models.State.MetricStatus.Critical => "crit",
                                        Minicon.SimpleAdmin.Models.State.MetricStatus.Warning => "warn",
                                        _ => "ok"
                                    };
                                    <span class="pill pill-@elTone" title="Event-Log: @server.EventLogs.EventCount Ereignis(se)">
                                        <i class="bi bi-journal-text"></i>@server.EventLogs.EventCount Events
                                    </span>
                                }
                            </div>
                        }

                        <ul class="list-unstyled status-service-list mb-0">
                            @foreach (var service in server.Services.OrderBy(s => s.Service))
                            {
                                var htmlUrl = server.BaseUrl != null
                                    ? $"{server.BaseUrl.TrimEnd('/')}/{server.ServerId}.{service.Service}.html"
                                    : null;
                                <li class="d-flex align-items-center gap-2">
                                    <span class="status-dot status-dot-@Display.Tone(service.Status)" title="@Display.Label(service.Status)"></span>
                                    <span class="flex-grow-1 text-truncate">@service.Service</span>
                                    <span class="small text-body-secondary">@Display.Label(service.Status)</span>
                                    @if (htmlUrl != null)
                                    {
                                        <a href="@htmlUrl" target="_blank" rel="noopener" class="btn btn-sm btn-glass py-0 px-2 position-relative z-2"
                                           title="Statischen HTML-Report öffnen" aria-label="HTML-Report @service.Service">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer small text-body-secondary">
                        <i class="bi bi-clock me-1"></i>Letzte Prüfung:
                        <time class="relative-time" data-utc="@Display.Iso(server.LastCheck)" title="@Display.LocalTimeSeconds(server.LastCheck)">@Display.LocalTime(server.LastCheck)</time>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center text-body-secondary py-5 d-none" id="statusEmpty">
        <i class="bi bi-funnel fs-2 d-block mb-2"></i>Keine Server für diesen Filter.
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Keine Server-Statusdaten verfügbar. Stellen Sie sicher, dass SimpleAdmin ausgeführt wird und die Statusdaten gespeichert wurden.
    </div>

    @if (ViewData["Diagnostics"] is Minicon.SimpleAdmin.WebUI.ViewModels.StatusSourceDiagnostics diag)
    {
        <div class="card border-warning mb-4" id="statusDiagnostics">
            <div class="card-header">
                <i class="bi bi-search me-2"></i><strong>Warum werden keine Einträge angezeigt?</strong>
            </div>
            <div class="card-body">
                <h6>Wahrscheinliche Ursachen</h6>
                <ul class="mb-4">
                    @foreach (var reason in diag.Reasons)
                    {
                        <li>@reason</li>
                    }
                </ul>

                <h6>Aktuelle Einstellungen</h6>
                <table class="table table-sm small mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 30%;">config.json</th>
                            <td>
                                @if (diag.ConfigLoaded)
                                {
                                    <span class="badge bg-success me-1">geladen</span><code>@(diag.ConfigFilePath ?? "–")</code>
                                }
                                else
                                {
                                    <span class="badge bg-danger me-1">nicht geladen</span>@diag.ConfigLoadError
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>StatusDirectory <span class="text-muted fw-normal">(appsettings.json)</span></th>
                            <td><code>@diag.DefaultStatusDirectory</code></td>
                        </tr>
                        <tr>
                            <th>output.centralOutputPath <span class="text-muted fw-normal">(config.json)</span></th>
                            <td>
                                @if (string.IsNullOrWhiteSpace(diag.CentralOutputPath))
                                {
                                    <span class="text-muted">nicht gesetzt — StatusDirectory wird verwendet</span>
                                }
                                else
                                {
                                    <code>@diag.CentralOutputPath</code><span class="text-muted"> — hat Vorrang vor StatusDirectory</span>
                                }
                            </td>
                        </tr>
                        @for (var i = 0; i < diag.Directories.Count; i++)
                        {
                            var dir = diag.Directories[i];
                            var optional = i > 0;
                            <tr>
                                <th>@(optional ? "Unterordner (optional)" : "Gelesenes Verzeichnis")</th>
                                <td>
                                    <code>@dir.Path</code><br />
                                    @if (!dir.Exists)
                                    {
                                        <span class="badge @(optional ? "bg-secondary" : "bg-danger")">@(optional ? "nicht vorhanden" : "existiert nicht / nicht lesbar")</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(dir.JsonFileCount > 0 ? "bg-success" : "bg-secondary")">@dir.JsonFileCount JSON-Datei(en)</span>
                                        @if (dir.NewestFileUtc.HasValue)
                                        {
                                            <span class="text-muted ms-1">neueste: @Display.LocalTime(dir.NewestFileUtc.Value)</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                        <tr>
                            <th>output.pullStatusOverHttp</th>
                            <td>@(diag.PullStatusOverHttp ? "aktiv" : "deaktiviert")</td>
                        </tr>
                        <tr>
                            <th>Server in config.json</th>
                            <td>@diag.ServerCount gesamt · @diag.ActiveServerCount aktiv · @diag.ActiveServersWithBaseUrl aktiv mit baseUrl</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@section Scripts {
<script>
    // Status filter (tile) + text search, kept in the query string (?status=Unhealthy&q=srv) like the Problems page.
    document.addEventListener('DOMContentLoaded', function () {
        const tiles = Array.from(document.querySelectorAll('.status-filter'));
        const cards = Array.from(document.querySelectorAll('.server-card'));
        const search = document.getElementById('statusSearch');
        if (!search) return;

        const params = new URLSearchParams(window.location.search);
        let activeStatus = tiles.some(t => t.dataset.status === params.get('status')) ? params.get('status') : null;
        search.value = params.get('q') || '';

        function apply() {
            const needle = search.value.trim().toLowerCase();
            let visible = 0;
            cards.forEach(card => {
                const show = (!activeStatus || card.dataset.status === activeStatus)
                    && (!needle || card.dataset.search.includes(needle));
                card.classList.toggle('d-none', !show);
                if (show) visible++;
            });
            tiles.forEach(tile => {
                const active = tile.dataset.status === activeStatus;
                tile.classList.toggle('active', active);
                tile.classList.toggle('dimmed', !!activeStatus && !active);
                tile.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            document.getElementById('statusSummary').textContent = visible + ' von ' + cards.length + ' Servern';
            document.getElementById('statusReset').classList.toggle('d-none', !activeStatus && !needle);
            document.getElementById('statusEmpty').classList.toggle('d-none', visible > 0);

            const query = new URLSearchParams();
            if (activeStatus) query.set('status', activeStatus);
            if (needle) query.set('q', search.value.trim());
            const qs = query.toString();
            history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
        }

        tiles.forEach(tile => tile.addEventListener('click', () => {
            activeStatus = activeStatus === tile.dataset.status ? null : tile.dataset.status;
            apply();
        }));
        search.addEventListener('input', apply);
        document.getElementById('statusReset').addEventListener('click', () => {
            activeStatus = null;
            search.value = '';
            apply();
        });

        apply();
    });
</script>
}
