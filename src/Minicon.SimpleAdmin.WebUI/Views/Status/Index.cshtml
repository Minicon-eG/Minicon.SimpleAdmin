@{
	ViewData["Title"] = "Status";
}

<div class="row">
	<div class="col">
		<h1><i class="bi bi-display me-2"></i>System Status</h1>
		<p class="text-muted">Übersicht über den Status aller überwachten Server</p>
	</div>
	<div class="col-auto">
		<button class="btn btn-outline-secondary" id="btn-refresh">
			<i class="bi bi-arrow-clockwise me-1"></i>Aktualisieren
		</button>
	</div>
</div>

<div class="row mb-4" id="summary-row">
	<div class="col-auto">
		<div class="card text-white bg-success status-filter" data-status="Healthy" role="button" style="min-width: 120px; cursor: pointer;">
			<div class="card-body text-center">
				<h2 class="mb-0" id="count-healthy">–</h2>
				<small>Healthy</small>
			</div>
		</div>
	</div>
	<div class="col-auto">
		<div class="card text-white bg-warning status-filter" data-status="Degraded" role="button" style="min-width: 120px; cursor: pointer;">
			<div class="card-body text-center">
				<h2 class="mb-0" id="count-degraded">–</h2>
				<small>Warning</small>
			</div>
		</div>
	</div>
	<div class="col-auto">
		<div class="card text-white bg-danger status-filter" data-status="Unhealthy" role="button" style="min-width: 120px; cursor: pointer;">
			<div class="card-body text-center">
				<h2 class="mb-0" id="count-unhealthy">–</h2>
				<small>Critical</small>
			</div>
		</div>
	</div>
	<div class="col-auto">
		<div class="card text-white bg-secondary status-filter" data-status="Unknown" role="button" style="min-width: 120px; cursor: pointer;">
			<div class="card-body text-center">
				<h2 class="mb-0" id="count-unknown">–</h2>
				<small>Unknown</small>
			</div>
		</div>
	</div>
	<div class="col-auto">
		<div class="card text-white bg-info status-filter" data-status="Acknowledged" role="button" style="min-width: 120px; cursor: pointer;">
			<div class="card-body text-center">
				<h2 class="mb-0" id="count-acknowledged">–</h2>
				<small>Acknowledged</small>
			</div>
		</div>
	</div>
</div>

@* Loading indicator *@
<div id="loading-indicator" class="text-center my-5">
	<div class="spinner-border text-primary" role="status"></div>
	<p class="mt-2 text-muted">Lade Statusdaten…</p>
</div>

@* Error state *@
<div id="error-state" class="alert alert-danger" style="display:none;">
	<i class="bi bi-exclamation-triangle me-2"></i>
	<span id="error-message">Fehler beim Laden der Statusdaten.</span>
</div>

@* Server cards grid *@
<div class="row g-3" id="server-grid" style="display:none;"></div>

@* Empty state *@
<div id="empty-state" class="alert alert-info" style="display:none;">
	<i class="bi bi-info-circle me-2"></i>Keine Server-Statusdaten verfügbar. Stellen Sie sicher, dass SimpleAdmin ausgeführt wird und die Statusdaten gespeichert wurden.
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
	var activeFilter = null;
	var allServers = [];
	var filterCards = document.querySelectorAll('.status-filter');
	var serverGrid = document.getElementById('server-grid');
	var loadingIndicator = document.getElementById('loading-indicator');
	var errorState = document.getElementById('error-state');
	var emptyState = document.getElementById('empty-state');
	var summaryRow = document.getElementById('summary-row');

	// Initially hide summary numbers until data loads
	document.querySelectorAll('[id^="count-"]').forEach(function(el) {
		el.textContent = '–';
	});

	// Filter click handler
	filterCards.forEach(function(card) {
		card.addEventListener('click', function() {
			var status = this.dataset.status;
			if (activeFilter === status) {
				activeFilter = null;
				filterCards.forEach(function(c) { c.style.opacity = '1'; });
				showAllServers();
			} else {
				activeFilter = status;
				filterCards.forEach(function(c) {
					c.style.opacity = c.dataset.status === status ? '1' : '0.4';
				});
				filterServers(status);
			}
		});
	});

	// Refresh button
	document.getElementById('btn-refresh').addEventListener('click', function() {
		loadStatusData(true);
	});

	function loadStatusData(forceRefresh) {
		loadingIndicator.style.display = 'block';
		errorState.style.display = 'none';
		emptyState.style.display = 'none';
		serverGrid.style.display = 'none';

		var url = '@Url.Action("GetAllServersJson", "Status")';
		if (forceRefresh) url += '?forceRefresh=true';

		fetch(url)
			.then(function(response) {
				if (!response.ok) throw new Error('HTTP ' + response.status);
				return response.json();
			})
			.then(function(data) {
				allServers = data || [];
				loadingIndicator.style.display = 'none';
				renderServers(allServers);
			})
			.catch(function(err) {
				loadingIndicator.style.display = 'none';
				document.getElementById('error-message').textContent =
					'Fehler beim Laden: ' + err.message;
				errorState.style.display = 'block';
			});
	}

	function renderServers(servers) {
		// Update summary counts
		var services = [];
		servers.forEach(function(s) { services = services.concat(s.Services || []); });

		document.getElementById('count-healthy').textContent =
			services.filter(function(s) { return s.Status === 'Healthy'; }).length;
		document.getElementById('count-degraded').textContent =
			services.filter(function(s) { return s.Status === 'Degraded'; }).length;
		document.getElementById('count-unhealthy').textContent =
			services.filter(function(s) { return s.Status === 'Unhealthy'; }).length;
		document.getElementById('count-unknown').textContent =
			services.filter(function(s) { return s.Status === 'Unknown'; }).length;
		document.getElementById('count-acknowledged').textContent =
			services.filter(function(s) { return s.Status === 'Acknowledged'; }).length;

		if (servers.length === 0) {
			emptyState.style.display = 'block';
			return;
		}

		serverGrid.innerHTML = '';
		servers.forEach(function(server) {
			(server.Services || []).forEach(function(service) {
				serverGrid.appendChild(buildCard(server, service));
			});
		});

		serverGrid.style.display = 'flex';
	}

	function buildCard(server, service) {
		var statusClass = {
			'Healthy': 'border-success',
			'Degraded': 'border-warning',
			'Unhealthy': 'border-danger',
			'Acknowledged': 'border-info'
		}[service.Status] || 'border-secondary';

		var badgeClass = {
			'Healthy': 'bg-success',
			'Degraded': 'bg-warning text-dark',
			'Unhealthy': 'bg-danger',
			'Acknowledged': 'bg-info text-dark'
		}[service.Status] || 'bg-secondary';

		var cpu = (service.Metrics || []).find(function(m) { return m.Name === 'cpu'; });
		var memory = (service.Metrics || []).find(function(m) { return m.Name === 'memory'; });

		var stoppedPools = 0, totalPools = 0;
		if (server.AppPools) {
			Object.values(server.AppPools).forEach(function(p) {
				totalPools++;
				if (p.Status !== 'Running') stoppedPools++;
			});
		}

		var stoppedSvcs = 0, totalSvcs = 0;
		if (server.WindowsServices) {
			Object.values(server.WindowsServices).forEach(function(s) {
				totalSvcs++;
				if (s.Status !== 'Running') stoppedSvcs++;
			});
		}

		var sqlCritical = 0, sqlTotal = 0;
		if (server.SqlQueryChecks) {
			Object.values(server.SqlQueryChecks).forEach(function(c) {
				sqlTotal++;
				if (c.Status === 'Critical') sqlCritical++;
			});
		}

		var detailsUrl = '@Url.Action("Details", "Status")?id=' + encodeURIComponent(server.ServerId);
		var staticHtmlUrl = null;
		if (server.BaseUrl) {
			staticHtmlUrl = server.BaseUrl.trimEnd('/') + '/' + server.ServerId + '.' + service.Service + '.html';
		}

		var html = '<div class="col-md-6 col-lg-4 server-card" data-status="' + service.Status + '">' +
			'<a href="' + detailsUrl + '" class="text-decoration-none text-reset">' +
			'<div class="card h-100 ' + statusClass + '" style="cursor:pointer;">' +
			'<div class="card-header d-flex justify-content-between align-items-center">' +
			'<h5 class="mb-0">' + server.ServerId + ' <small class="text-muted fw-normal">· ' + service.Service + '</small></h5>' +
			'<span class="badge ' + badgeClass + '">' + service.Status + '</span>' +
			'</div><div class="card-body>';

		if (cpu) {
			var cpuBadge = cpu.Status === 'Ok' ? 'success' : cpu.Status === 'Warning' ? 'warning' : 'danger';
			html += '<div class="mb-2"><strong>CPU:</strong> ' + cpu.Value.toFixed(1) + '%' +
				' <span class="badge bg-' + cpuBadge + '">' + cpu.Status + '</span></div>';
		}
		if (memory) {
			var memBadge = memory.Status === 'Ok' ? 'success' : memory.Status === 'Warning' ? 'warning' : 'danger';
			html += '<div class="mb-2"><strong>Memory:</strong> ' + memory.Value.toFixed(1) + '%' +
				' <span class="badge bg-' + memBadge + '">' + memory.Status + '</span></div>';
		}

		html += '</div>'; // card-body

		// Monitoring badges
		var badges = '';
		if (totalPools > 0) {
			var poolBadge = stoppedPools > 0 ? 'bg-danger' : 'bg-success';
			badges += '<span class="badge ' + poolBadge + '" title="App Pools">' +
				'<i class="bi bi-layers me-1"></i>' + (totalPools - stoppedPools) + '/' + totalPools + ' Pools</span> ';
		}
		if (totalSvcs > 0) {
			var svcBadge = stoppedSvcs > 0 ? 'bg-danger' : 'bg-success';
			badges += '<span class="badge ' + svcBadge + '" title="Windows Services">' +
				'<i class="bi bi-window me-1"></i>' + (totalSvcs - stoppedSvcs) + '/' + totalSvcs + ' Svcs</span> ';
		}
		if (sqlTotal > 0) {
			var sqlBadge = sqlCritical > 0 ? 'bg-danger' : 'bg-success';
			badges += '<span class="badge ' + sqlBadge + '" title="SQL Checks">' +
				'<i class="bi bi-database me-1"></i>' + (sqlTotal - sqlCritical) + '/' + sqlTotal + ' SQL</span> ';
		}
		if (server.EventLogs) {
			var elBadge = server.EventLogs.Status === 'Critical' ? 'bg-danger' :
				server.EventLogs.Status === 'Warning' ? 'bg-warning text-dark' : 'bg-success';
			badges += '<span class="badge ' + elBadge + '">' +
				'<i class="bi bi-journal-text me-1"></i>' + server.EventLogs.EventCount + ' Events</span> ';
		}
		if (badges) html += '<div class="p-2 pt-0" style="font-size:0.85em"><div style="display:flex;flex-wrap:wrap;gap:4px">' + badges + '</div></div>';

		var lastUpdate = service.LastUpdate
			? new Date(service.LastUpdate).toISOString().slice(0,19).replace('T',' ') + ' UTC'
			: 'N/A';
		html += '<div class="card-footer d-flex justify-content-between align-items-center">' +
			'<small class="text-muted">Letzte Prüfung: ' + lastUpdate + '</small>';
		if (staticHtmlUrl) {
			html += '<a href="' + staticHtmlUrl + '" target="_blank" class="btn btn-sm btn-outline-secondary" onclick="event.stopPropagation()">' +
				'<i class="bi bi-box-arrow-up-right me-1"></i>HTML</a>';
		}
		html += '</div></div></a></div>';

		var wrapper = document.createElement('div');
		wrapper.innerHTML = html;
		return wrapper.firstElementChild;
	}

	function filterServers(status) {
		var cards = serverGrid.querySelectorAll('.server-card');
		cards.forEach(function(c) {
			c.style.display = c.dataset.status === status ? '' : 'none';
		});
	}

	function showAllServers() {
		var cards = serverGrid.querySelectorAll('.server-card');
		cards.forEach(function(c) { c.style.display = ''; });
	}

	// Start loading immediately on page load
	loadStatusData(false);

	// Background refresh: reload silently every 30 seconds when tab is visible
	var refreshInterval = setInterval(function() {
		if (!document.hidden) {
			loadStatusData(false);
		}
	}, 30000);

	// Stop refresh when leaving the page
	document.addEventListener('visibilitychange', function() {
		if (document.hidden) {
			clearInterval(refreshInterval);
		} else {
			loadStatusData(false);
			refreshInterval = setInterval(function() {
				if (!document.hidden) loadStatusData(false);
			}, 30000);
		}
	});
});
</script>
}
