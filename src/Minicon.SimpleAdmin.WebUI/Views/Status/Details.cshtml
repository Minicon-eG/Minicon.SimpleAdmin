@model Minicon.SimpleAdmin.WebUI.ViewModels.ServerStatusView
@using StatusNs = Minicon.SimpleAdmin.Models.Status
@using StateNs = Minicon.SimpleAdmin.Models.State

@{
    ViewData["Title"] = $"Status - {Model.ServerId}";

    // Key matches history snapshot key: "disk_C:" / "disk_D:" for targeted metrics
    static string MetricKey(StatusNs.Metric m) =>
        string.IsNullOrEmpty(m.Target) ? m.Name : $"{m.Name}_{m.Target}";

    static string ChartId(string metricKey) =>
        "chart-" + System.Text.RegularExpressions.Regex.Replace(metricKey.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    // Metric problems (cpu/memory/disk) point to the history chart of their metric.
    static string? ProblemMetricKey(StateNs.ActiveProblem p) => p.Type switch
    {
        "cpu" or "memory" => p.Type,
        "disk" when p.Context.TryGetValue("drive", out var drive) => $"disk_{drive}",
        _ => null
    };

    static bool Exceeds(double value, double? limit, string op) => limit.HasValue && op switch
    {
        "<" => value < limit,
        "<=" => value <= limit,
        ">=" => value >= limit,
        _ => value > limit
    };

    // Machine metrics are reported by every service type of the server. Per metric the history of the
    // service with the most samples is used, so values of different services are never mixed in one chart.
    var services = Model.Services ?? [];
    var metricHistory = services
        .Where(s => s.History?.Count > 0)
        .SelectMany(s => s.History.SelectMany(h => h.Values.Keys).Distinct().Select(key => (Key: key, Service: s)))
        .GroupBy(x => x.Key)
        .ToDictionary(
            g => g.Key,
            g => g.Select(x => x.Service.History.Where(h => h.Values.ContainsKey(g.Key)).OrderBy(h => h.Timestamp).ToList())
                  .OrderByDescending(list => list.Count)
                  .First()
                  .TakeLast(120)
                  .Select(h => (Time: h.Timestamp, Value: h.Values[g.Key]))
                  .ToList());

    var metricsByKey = Model.Metrics.GroupBy(MetricKey).ToDictionary(g => g.Key, g => g.First());

    string? ChartLink(string? metricKey) =>
        metricKey != null && metricHistory.ContainsKey(metricKey) ? "#" + ChartId(metricKey) : null;

    var openProblems = Model.ActiveProblems.Count(p => !p.Acknowledged);
    var staticBase = Model.BaseUrl?.TrimEnd('/');
}

<div class="page-head" id="top">
    <div>
        <div class="page-sub mt-0 mb-1">
            <a asp-action="Index" class="text-reset text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Status</a>
        </div>
        <h1>
            @Model.ServerId
            <span class="pill pill-lg pill-@Display.Tone(Model.OverallStatus)"><i class="bi @Display.Icon(Model.OverallStatus)"></i>@Display.Label(Model.OverallStatus)</span>
        </h1>
        <div class="page-sub">
            <i class="bi bi-clock me-1"></i>Aktualisiert
            <time class="relative-time" data-utc="@Display.Iso(Model.LastCheck)">@Display.LocalTimeSeconds(Model.LastCheck)</time>
            · @Display.LocalTimeSeconds(Model.LastCheck) · @services.Count @(services.Count == 1 ? "Dienst" : "Dienste") überwacht
        </div>
    </div>
    <div class="page-actions">
        <partial name="_AutoRefresh" />
        <button type="button" class="btn btn-primary" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>Aktualisieren
        </button>
    </div>
</div>

@* --- Metriken --- *@
@if (Model.Metrics.Count == 0)
{
    <div class="card mb-4">
        <div class="card-body text-body-secondary"><i class="bi bi-speedometer2 me-2"></i>Keine Metriken verfügbar.</div>
    </div>
}
else
{
    var metricColumn = Model.Metrics.Count switch { 1 => "col-xl-6", 2 => "col-xl-6", 3 => "col-xl-4", _ => "col-xl-3" };
    <div class="row g-3 mb-4">
        @foreach (var metric in Model.Metrics)
        {
            var key = MetricKey(metric);
            var chartLink = ChartLink(key);
            var tone = Display.Tone(metric.Status);
            var progressValue = Math.Clamp(metric.Value, 0, 100);
            var spark = metricHistory.TryGetValue(key, out var sparkPoints) && sparkPoints.Count > 1
                ? new ChartGeometry(sparkPoints.TakeLast(30).Select(p => p.Value).ToList(), 110, 40,
                    includeMin: metric.Unit.Trim() == "%" ? 0 : null, includeMax: metric.Unit.Trim() == "%" ? 100 : null)
                : null;
            var sparkColor = tone is "ok" or "warn" or "crit" ? $"var(--sa-{tone})" : "#94a3b8";
            var icon = metric.Name switch
            {
                "cpu" => "bi-cpu",
                "memory" => "bi-memory",
                "disk" => "bi-device-hdd",
                _ => "bi-speedometer2"
            };

            <div class="col-sm-6 @metricColumn">
                <div class="card h-100 metric-tile @(chartLink != null ? "metric-chart-link" : "") @(metric.Status == StatusNs.MetricStatus.Critical ? "card-alert" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>
                                <i class="bi @icon me-1"></i>
                                @if (chartLink != null)
                                {
                                    <a href="@chartLink" class="stretched-link text-reset text-decoration-none" title="Verlauf anzeigen">@metric.DisplayName</a>
                                }
                                else
                                {
                                    @metric.DisplayName
                                }
                            </strong>
                            <span class="pill pill-@tone">@Display.Label(metric.Status)</span>
                        </div>
                        <div class="d-flex align-items-end justify-content-between gap-3 mt-2">
                            <div class="metric-value">@metric.Value.ToString("F1")<small>@metric.Unit</small></div>
                            @if (spark != null)
                            {
                                <svg class="metric-spark" viewBox="0 0 110 40" preserveAspectRatio="none" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="spark-@ChartId(key)" x1="0" x2="0" y1="0" y2="1">
                                            <stop offset="0" style="stop-color: @sparkColor; stop-opacity: .35" />
                                            <stop offset="1" style="stop-color: @sparkColor; stop-opacity: 0" />
                                        </linearGradient>
                                    </defs>
                                    <path d="@spark.AreaPath()" fill="url(#spark-@ChartId(key))" />
                                    <path d="@spark.LinePath()" fill="none" style="stroke: @sparkColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                                </svg>
                            }
                        </div>
                        @{
                            var hints = new List<string>();
                            if (metric.AverageValue.HasValue) hints.Add($"Ø {metric.AverageValue.Value:F1}{metric.Unit}");
                            if (metric.Threshold?.Warning != null) hints.Add($"Warnung {metric.Threshold.Operator} {metric.Threshold.Warning}");
                            if (metric.Threshold?.Critical != null) hints.Add($"kritisch {metric.Threshold.Operator} {metric.Threshold.Critical}");
                        }
                        <div class="small text-body-secondary">
                            @string.Join(" · ", hints)
                            @if (chartLink != null)
                            {
                                <i class="bi bi-graph-up ms-1"></i>
                            }
                        </div>
                        <div class="progress mt-3" role="progressbar" aria-label="@metric.DisplayName"
                             aria-valuenow="@progressValue.ToString("F0")" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-@(tone switch { "ok" => "success", "warn" => "warning", "crit" => "danger", _ => "secondary" })"
                                 style="width: @progressValue.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* --- Probleme --- *@
@if (Model.ActiveProblems.Count > 0)
{
    <div class="card mb-4 @(openProblems > 0 && Model.ActiveProblems.Any(p => !p.Acknowledged && p.Severity == StateNs.ProblemSeverity.Critical) ? "card-alert" : "")">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="detail-section-title">
                <i class="bi bi-exclamation-triangle"></i>Aktive Probleme
                <span class="pill @(openProblems > 0 ? "pill-crit" : "pill-ack")">@openProblems offen</span>
            </h5>
            @if (openProblems < Model.ActiveProblems.Count)
            {
                <small class="text-body-secondary">@(Model.ActiveProblems.Count - openProblems) quittiert</small>
            }
        </div>
        @* Same fixed layout as the Problems page (site.css .problem-table): long texts wrap,
           below 1200px the rows become cards — no horizontal scrolling. *@
        <div>
            <table class="table table-hover mb-0 problem-table problem-table-compact">
                <colgroup>
                    <col />
                    <col class="col-severity" />
                    <col class="col-since" />
                    <col class="col-status" />
                    <col class="col-action" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="ps-3">Problem</th>
                        <th>Schweregrad</th>
                        <th>Seit</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Aktion</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var problem in Model.ActiveProblems.OrderBy(p => p.Acknowledged).ThenByDescending(p => p.Severity))
                    {
                        var problemChartLink = ChartLink(ProblemMetricKey(problem));
                        var origin = string.IsNullOrWhiteSpace(problem.Source) ? problem.Type : $"{problem.Type} · {problem.Source}";
                        var title = string.IsNullOrWhiteSpace(problem.Message) ? origin : problem.Message;

                        <tr class="@(problem.Acknowledged ? "text-body-secondary" : "")">
                            <td class="ps-3 problem-main">
                                @if (problemChartLink != null)
                                {
                                    <a href="@problemChartLink" class="fw-semibold" title="Verlauf anzeigen">@title<i class="bi bi-graph-up ms-2"></i></a>
                                }
                                else
                                {
                                    <span class="fw-semibold">@title</span>
                                }
                                <div class="small text-body-secondary"><code class="problem-origin">@origin</code></div>
                                @if (!string.IsNullOrEmpty(problem.WikiUrl) || problem.RemediationSteps.Count > 0)
                                {
                                    <div class="small mt-1 d-flex flex-wrap gap-3">
                                        @if (!string.IsNullOrEmpty(problem.WikiUrl))
                                        {
                                            <a href="@problem.WikiUrl" target="_blank" rel="noopener"><i class="bi bi-book me-1"></i>Lösungsanleitung</a>
                                        }
                                        @if (problem.RemediationSteps.Count > 0)
                                        {
                                            <details class="problem-steps">
                                                <summary>Lösungsschritte (@problem.RemediationSteps.Count)</summary>
                                                <ol class="text-body-secondary mb-0 mt-1 ps-3">
                                                    @foreach (var step in problem.RemediationSteps)
                                                    {
                                                        <li>@step</li>
                                                    }
                                                </ol>
                                            </details>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="cell-severity"><span class="pill pill-@Display.Tone(problem.Severity)"><i class="bi @Display.Icon(problem.Severity)"></i>@Display.Label(problem.Severity)</span></td>
                            <td class="cell-since">
                                <time class="relative-time" data-utc="@Display.Iso(problem.FirstOccurrence)"
                                      title="Erstmals: @Display.LocalTime(problem.FirstOccurrence) · Zuletzt: @Display.LocalTime(problem.LastOccurrence)">@Display.LocalTime(problem.FirstOccurrence)</time>
                            </td>
                            <td class="cell-status">
                                @if (problem.Acknowledged)
                                {
                                    <span class="pill pill-soft pill-ack"><i class="bi bi-check2-circle"></i>Quittiert</span>
                                    <div class="small text-body-secondary mt-1">
                                        @(problem.AcknowledgeExpiresAt.HasValue ? "bis " + Display.LocalTime(problem.AcknowledgeExpiresAt.Value) : "unbegrenzt")
                                        @if (!string.IsNullOrEmpty(problem.AcknowledgedBy))
                                        {
                                            <span> · @problem.AcknowledgedBy</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="pill pill-soft pill-crit"><i class="bi bi-circle-fill" style="font-size: .5rem;"></i>Offen</span>
                                }
                            </td>
                            <td class="text-end pe-3 text-nowrap cell-action">
                                @if (!problem.Acknowledged)
                                {
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-problem-id="@problem.Id" onclick="acknowledgeProblem(this.dataset.problemId, '@Model.ServerId')">
                                        <i class="bi bi-check2 me-1"></i>Quittieren
                                    </button>
                                }
                                else if (!string.IsNullOrEmpty(problem.AcknowledgeId))
                                {
                                    <button type="button" class="btn btn-sm btn-glass"
                                            data-ack-id="@problem.AcknowledgeId" onclick="cancelAcknowledge(this.dataset.ackId)"
                                            title="Quittierung aufheben — das Problem wird wieder gemeldet">
                                        <i class="bi bi-arrow-counterclockwise me-1"></i>Aufheben
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* --- Dienste --- *@
<div class="card mb-4">
    <div class="card-header">
        <h5 class="detail-section-title"><i class="bi bi-hdd-network"></i>Dienste</h5>
    </div>
    <div class="card-body py-1">
        @if (services.Count == 0)
        {
            <p class="text-body-secondary my-3">Keine Dienste verfügbar.</p>
        }
        else
        {
            @foreach (var service in services.OrderBy(s => s.Service))
            {
                var tone = Display.Tone(service.Status);
                var enabledEndpoints = service.Endpoints?.Where(e => e.Enabled).ToList() ?? [];

                <div class="service-row">
                    <span class="status-dot status-dot-@tone"></span>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@service.Service</div>
                        <div class="small text-body-secondary">
                            @foreach (var ep in enabledEndpoints)
                            {
                                <span class="me-3">@ep.Type: @ep.Path</span>
                            }
                            <span>aktualisiert <time class="relative-time" data-utc="@Display.Iso(service.LastUpdate)" title="@Display.LocalTime(service.LastUpdate)">@Display.LocalTime(service.LastUpdate)</time></span>
                        </div>
                    </div>
                    <div class="d-none d-md-flex flex-wrap gap-1 justify-content-end">
                        @foreach (var m in service.Metrics.Take(3))
                        {
                            var mChartLink = ChartLink(MetricKey(m));
                            var mBadge = Display.Tone(m.Status) switch { "ok" => "bg-success", "warn" => "bg-warning", "crit" => "bg-danger", _ => "bg-secondary" };
                            if (mChartLink != null)
                            {
                                <a href="@mChartLink" class="badge @mBadge text-decoration-none" title="Verlauf anzeigen">@m.DisplayName: @m.Value.ToString("F1")@m.Unit <i class="bi bi-graph-up"></i></a>
                            }
                            else
                            {
                                <span class="badge @mBadge">@m.DisplayName: @m.Value.ToString("F1")@m.Unit</span>
                            }
                        }
                    </div>
                    <span class="pill pill-@tone">@Display.Label(service.Status)</span>
                    @if (staticBase != null)
                    {
                        <a href="@($"{staticBase}/{Model.ServerId}.{service.Service}.html")" target="_blank" rel="noopener"
                           class="btn btn-sm btn-glass" title="Statischen HTML-Report öffnen">
                            <i class="bi bi-box-arrow-up-right"></i><span class="d-none d-lg-inline ms-1">HTML-Report</span>
                        </a>
                    }
                </div>
            }
        }
    </div>
</div>

@* --- Verlaufs-Charts (Ziel der Links aus Metrik-Kacheln, Dienst-Badges und Problemen) --- *@
@if (metricHistory.Count > 0)
{
    <div class="row g-3 mb-4">
        @foreach (var (key, points) in metricHistory.OrderBy(kv => kv.Key))
        {
            if (points.Count == 0) continue;

            metricsByKey.TryGetValue(key, out var current);
            var displayName = current?.DisplayName ?? key;
            var unit = current?.Unit ?? "";
            var threshold = current?.Threshold;
            var op = threshold?.Operator ?? ">";
            var values = points.Select(p => p.Value).ToList();
            var isPercent = unit.Trim() == "%";
            var limits = new[] { threshold?.Warning, threshold?.Critical }.Where(v => v.HasValue).Select(v => v!.Value).ToList();

            const double plotWidth = 940, plotHeight = 200, left = 48, top = 12;
            var geo = new ChartGeometry(values, plotWidth, plotHeight,
                includeMin: isPercent ? 0 : Math.Min(0, values.Min()),
                includeMax: isPercent ? 100 : (limits.Count > 0 ? limits.Max() : null));

            var last = values[^1];
            var lastTone = Exceeds(last, threshold?.Critical, op) ? "crit" : Exceeds(last, threshold?.Warning, op) ? "warn" : "ok";
            var lineColor = $"var(--sa-{lastTone})";
            var gradientId = "area-" + ChartId(key);
            var ticks = Enumerable.Range(0, 5).Select(i => geo.Min + (geo.Max - geo.Min) * i / 4).ToList();
            var labelEvery = Math.Max(1, points.Count / 6);

            <div class="col-12 col-xxl-6">
                <div class="card h-100 metric-chart" id="@ChartId(key)">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="detail-section-title"><i class="bi bi-graph-up"></i>@displayName</h5>
                        <div class="d-flex align-items-center gap-3">
                            <small class="text-body-secondary">@points.Count Messwerte · @Display.LocalShort(points[0].Time) – @Display.LocalShort(points[^1].Time)</small>
                            <a href="#top" class="small text-decoration-none" title="Zur Übersicht"><i class="bi bi-arrow-up"></i></a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <div class="chart-stats">
                                <span>Aktuell <strong>@last.ToString("F1")@unit</strong></span>
                                <span>Ø <strong>@values.Average().ToString("F1")@unit</strong></span>
                                <span>Min <strong>@values.Min().ToString("F1")@unit</strong></span>
                                <span>Max <strong>@values.Max().ToString("F1")@unit</strong></span>
                            </div>
                            @if (limits.Count > 0)
                            {
                                <div class="chart-legend">
                                    @if (threshold?.Warning != null)
                                    {
                                        <span><span class="swatch" style="background: var(--sa-warn)"></span>Warnung @op @threshold.Warning@unit</span>
                                    }
                                    @if (threshold?.Critical != null)
                                    {
                                        <span><span class="swatch" style="background: var(--sa-crit)"></span>Kritisch @op @threshold.Critical@unit</span>
                                    }
                                </div>
                            }
                        </div>
                        <svg class="history-chart" viewBox="0 0 1000 240" role="img" aria-label="Verlauf @displayName">
                            <defs>
                                <linearGradient id="@gradientId" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0" style="stop-color: @lineColor; stop-opacity: .32" />
                                    <stop offset="1" style="stop-color: @lineColor; stop-opacity: 0" />
                                </linearGradient>
                            </defs>
                            <g transform="translate(@ChartGeometry.F(left),@ChartGeometry.F(top))">
                                @foreach (var tick in ticks)
                                {
                                    var y = ChartGeometry.F(geo.Y(tick));
                                    <line class="grid-line" x1="0" x2="@ChartGeometry.F(plotWidth)" y1="@y" y2="@y" />
                                    @:<text class="axis-label" x="-8" y="@y" text-anchor="end" dominant-baseline="middle">@tick.ToString("0.#")</text>
                                }
                                @if (threshold?.Warning != null)
                                {
                                    var y = ChartGeometry.F(geo.Y(threshold.Warning.Value));
                                    <line x1="0" x2="@ChartGeometry.F(plotWidth)" y1="@y" y2="@y" style="stroke: var(--sa-warn)" stroke-dasharray="6 5" opacity=".8" />
                                }
                                @if (threshold?.Critical != null)
                                {
                                    var y = ChartGeometry.F(geo.Y(threshold.Critical.Value));
                                    <line x1="0" x2="@ChartGeometry.F(plotWidth)" y1="@y" y2="@y" style="stroke: var(--sa-crit)" stroke-dasharray="6 5" opacity=".8" />
                                }
                                <path d="@geo.AreaPath()" fill="url(#@gradientId)" />
                                <path d="@geo.LinePath()" fill="none" style="stroke: @lineColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                                @for (var i = 0; i < points.Count; i++)
                                {
                                    var point = points[i];
                                    var cx = ChartGeometry.F(geo.X(i));
                                    var cy = ChartGeometry.F(geo.Y(point.Value));
                                    var pointTone = Exceeds(point.Value, threshold?.Critical, op) ? "crit" : Exceeds(point.Value, threshold?.Warning, op) ? "warn" : "ok";
                                    @* Wide invisible hit area per point; the dot appears on hover/focus *@
                                    <rect class="hover-target" x="@ChartGeometry.F(geo.X(i) - plotWidth / Math.Max(points.Count, 2) / 2)" y="0"
                                          width="@ChartGeometry.F(plotWidth / Math.Max(points.Count, 2))" height="@ChartGeometry.F(plotHeight)" fill="transparent">
                                        <title>@Display.LocalTime(point.Time): @point.Value.ToString("F1")@unit</title>
                                    </rect>
                                    <circle class="hover-dot" cx="@cx" cy="@cy" r="5" style="fill: var(--sa-@pointTone); stroke: var(--sa-surface-solid)" stroke-width="2" />
                                    if (i % labelEvery == 0 && i < points.Count - labelEvery / 2)
                                    {
                                        @:<text class="axis-label" x="@cx" y="@ChartGeometry.F(plotHeight + 20)" text-anchor="middle">@Display.LocalShort(point.Time)</text>
                                    }
                                }
                                <circle cx="@ChartGeometry.F(geo.X(points.Count - 1))" cy="@ChartGeometry.F(geo.Y(last))" r="5"
                                        style="fill: @lineColor; stroke: var(--sa-surface-solid)" stroke-width="2" />
                            </g>
                        </svg>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* --- AppPools --- *@
@if (Model.AppPools?.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-layers me-2"></i>Anwendungspools</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Arbeitsspeicher</th>
                            <th>Uptime</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pool in Model.AppPools.OrderBy(p => p.Key))
                        {
                            var poolBadge = pool.Value.Status switch
                            {
                                StateNs.AppPoolStatus.Running => "bg-success",
                                StateNs.AppPoolStatus.Stopped => "bg-danger",
                                StateNs.AppPoolStatus.Starting => "bg-warning text-dark",
                                StateNs.AppPoolStatus.Stopping => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                            var memBadge = pool.Value.MemoryStatus switch
                            {
                                StateNs.MetricStatus.Critical => "bg-danger",
                                StateNs.MetricStatus.Warning  => "bg-warning text-dark",
                                _                             => "bg-success"
                            };
                            var uptimeBadge = pool.Value.UptimeStatus switch
                            {
                                StateNs.MetricStatus.Warning => "bg-warning text-dark",
                                _                            => "bg-success"
                            };

                            <tr data-pool="@pool.Key">
                                <td>@pool.Key</td>
                                <td><span class="badge @poolBadge">@(pool.Value.Status switch { StateNs.AppPoolStatus.Running => "Läuft", StateNs.AppPoolStatus.Stopped => "Gestoppt", _ => pool.Value.Status.ToString() })</span></td>
                                <td>
                                    @if (pool.Value.Status == StateNs.AppPoolStatus.Running && pool.Value.WorkerProcessId.HasValue)
                                    {
                                        <span class="badge @memBadge">@pool.Value.MemoryMB.ToString("F0") MB</span>
                                        if (pool.Value.MemoryWarningMB > 0)
                                        {
                                            <small class="text-muted ms-1">/ @pool.Value.MemoryWarningMB MB</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }
                                </td>
                                <td>
                                    @if (pool.Value.Status == StateNs.AppPoolStatus.Running && pool.Value.WorkerProcessId.HasValue && pool.Value.UptimeHours > 0)
                                    {
                                        <span class="badge @uptimeBadge">@pool.Value.UptimeHours.ToString("F1") h</span>
                                        if (pool.Value.UptimeWarningHours > 0)
                                        {
                                            <small class="text-muted ms-1">/ @pool.Value.UptimeWarningHours h</small>
                                        }
                                    }
                                    else if (pool.Value.Status == StateNs.AppPoolStatus.Stopped && pool.Value.StoppedSince.HasValue)
                                    {
                                        <small class="text-body-secondary" title="seit @Display.LocalTime(pool.Value.StoppedSince.Value)">Gestoppt seit @Display.Duration(DateTime.UtcNow - Display.AsUtc(pool.Value.StoppedSince.Value))</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">–</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* --- Windows Services --- *@
@if (Model.WindowsServices?.Count > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-window me-2"></i>Windows-Dienste</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Anzeigename</th>
                            <th>Status</th>
                            <th>Startart</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in Model.WindowsServices.OrderBy(s => s.Key))
                        {
                            var svcBadge = svc.Value.Status switch
                            {
                                "Running" => "bg-success",
                                "Stopped" or "PatternNoMatch" => "bg-danger",
                                "Starting" or "Stopping" or "ContinuePending" or "PausePending" => "bg-warning text-dark",
                                "Paused" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td><code>@svc.Key</code></td>
                                <td>@svc.Value.DisplayName</td>
                                <td><span class="badge @svcBadge">@(svc.Value.Status == "PatternNoMatch" ? "Kein Dienst gefunden" : svc.Value.Status)</span></td>
                                <td>@(svc.Value.StartupType switch { "Automatic" => "Automatisch", "Manual" => "Manuell", _ => "–" })</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* --- Event Log --- *@
@if (Model.EventLogs != null && (Model.EventLogs.RecentEvents.Count > 0 || Model.EventLogs.IgnoredCount > 0))
{
    var elBadge = Model.EventLogs.Status switch
    {
        StateNs.MetricStatus.Critical => "bg-danger",
        StateNs.MetricStatus.Warning  => "bg-warning text-dark",
        _                             => "bg-success"
    };
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-journal-text me-2"></i>Event Log</h5>
            <span class="badge @elBadge">
                @Model.EventLogs.EventCount Ereignisse@(Model.EventLogs.IgnoredCount > 0 ? $" ({Model.EventLogs.IgnoredCount} ignoriert)" : "")
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Zeitstempel</th>
                            <th>Level</th>
                            <th>Quelle</th>
                            <th>ID</th>
                            <th>Meldung</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EventLogs.RecentEvents.Count == 0)
                        {
                            <tr><td colspan="6" class="text-muted small">Keine aktuellen Ereignisse — alle gemeldeten Ereignisse werden ignoriert
                                (Regeln unter <em>Einstellungen → Feature-Toggles → Event Log</em>).</td></tr>
                        }
                        @foreach (var ev in Model.EventLogs.RecentEvents)
                        {
                            var evBadge = ev.Level switch
                            {
                                "Critical" or "Error" => "bg-danger",
                                "Warning"             => "bg-warning text-dark",
                                _                     => "bg-secondary"
                            };
                            <tr>
                                <td><small class="text-muted">@Display.LocalTimeSeconds(ev.Timestamp)</small></td>
                                <td><span class="badge @evBadge">@ev.Level</span></td>
                                <td><small>@ev.Source</small></td>
                                <td><small>@ev.EventId</small></td>
                                <td><small>@(ev.Message.Length > 120 ? ev.Message[..120] + "…" : ev.Message)</small></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0"
                                            data-source="@ev.Source" data-event-id="@ev.EventId"
                                            onclick="openEventIgnore(this)" title="Dieses Event auf diesem Server ignorieren">
                                        <i class="bi bi-eye-slash"></i> Ignorieren
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* --- SQL Query Checks --- *@
@if ((Model.SqlQueryChecks?.Count ?? 0) > 0)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-database me-2"></i>SQL-Prüfungen</h5>
        </div>
        <div class="card-body">
            @foreach (var (checkId, check) in (Model.SqlQueryChecks ?? []).OrderBy(kvp => kvp.Key))
            {
                var checkBadge = check.Status switch
                {
                    StateNs.MetricStatus.Critical => "bg-danger",
                    StateNs.MetricStatus.Warning  => "bg-warning text-dark",
                    _                             => "bg-success"
                };

                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong><i class="bi bi-database-check me-1"></i>@check.CheckName</strong>
                        <div>
                            <span class="badge @checkBadge">@Display.Label(check.Status)</span>
                            <small class="text-muted ms-2">@Display.LocalTimeSeconds(check.LastChecked)</small>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (!string.IsNullOrEmpty(check.ConnectionError))
                        {
                            <div class="alert alert-danger m-3 mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <strong>Verbindungsfehler:</strong> @check.ConnectionError
                            </div>
                        }
                        else if (check.Results.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Query</th>
                                            <th>Status</th>
                                            <th>Detail</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ var queryIdx = 0; }
                                        @foreach (var result in check.Results.OrderBy(r => r.QueryName))
                                        {
                                            var qBadge = result.Status switch
                                            {
                                                StateNs.MetricStatus.Critical => "bg-danger",
                                                StateNs.MetricStatus.Warning  => "bg-warning text-dark",
                                                _                             => "bg-success"
                                            };
                                            var rowsCollapseId = $"sql-rows-{checkId}-{queryIdx}";

                                            <tr>
                                                <td><strong>@result.QueryName</strong></td>
                                                <td><span class="badge @qBadge">@Display.Label(result.Status)</span></td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(result.ExecutionError))
                                                    {
                                                        <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@result.ExecutionError</span>
                                                    }
                                                    else
                                                    {
                                                        @if (result.RowCount != null)
                                                        {
                                                            var rcClass = result.RowCount.Passed ? "text-success" : "text-danger";
                                                            <span class="@rcClass me-2">
                                                                Rows: @result.RowCount.ActualCount @result.RowCount.Operator @result.RowCount.ExpectedCount
                                                                <i class="bi bi-@(result.RowCount.Passed ? "check" : "x")-circle ms-1"></i>
                                                            </span>
                                                        }
                                                        @foreach (var col in result.ColumnResults.OrderBy(c => c.AssertionName))
                                                        {
                                                            var colClass = col.Passed ? "text-success" : "text-danger";
                                                            <span class="@colClass me-2" title="@col.FailureReason">
                                                                @col.AssertionName: @col.ActualValue @col.Operator '@col.ExpectedValue'
                                                                <i class="bi bi-@(col.Passed ? "check" : "x")-circle ms-1"></i>
                                                            </span>
                                                        }
                                                    }
                                                    @if (result.Rows.Count > 0)
                                                    {
                                                        <div class="mt-2">
                                                            <button class="btn btn-sm btn-outline-secondary" type="button"
                                                                    data-bs-toggle="collapse" data-bs-target="#@rowsCollapseId">
                                                                <i class="bi bi-table me-1"></i>Ergebnis anzeigen (@result.Rows.Count von @result.TotalRows Zeilen)
                                                            </button>
                                                            <div class="collapse mt-2" id="@rowsCollapseId">
                                                                <div class="table-responsive">
                                                                    <table class="table table-sm table-bordered font-monospace small mb-0">
                                                                        <thead>
                                                                            <tr>
                                                                                @foreach (var colName in result.Columns)
                                                                                {
                                                                                    <th>@colName</th>
                                                                                }
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @foreach (var row in result.Rows)
                                                                            {
                                                                                <tr>
                                                                                    @foreach (var cell in row)
                                                                                    {
                                                                                        <td>@(cell ?? "NULL")</td>
                                                                                    }
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                    @if (result.TotalRows > result.Rows.Count)
                                                                    {
                                                                        <div class="alert alert-info py-1 mt-2 small mb-0">
                                                                            Nur die ersten @result.Rows.Count von @result.TotalRows Zeilen sind gespeichert.
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                            queryIdx++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted p-3 mb-0">Keine Abfrageergebnisse.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@* --- Email Probes (Sender Role) --- *@
@if ((Model.EmailProbes?.Count ?? 0) > 0)
{
    <div class="card mb-4">
        <div class="card-header">
