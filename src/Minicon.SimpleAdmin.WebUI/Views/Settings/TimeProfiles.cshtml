@model Minicon.SimpleAdmin.WebUI.Controllers.TimeProfilesViewModel
@{
    ViewData["Title"] = "Zeitprofile";
}

<div class="container-fluid">
    <h1 class="mb-4">
        <i class="bi bi-clock-history me-2"></i>Zeitprofile
    </h1>

    <p class="text-muted mb-4">
        Definieren Sie Zeitprofile für angepasste Schwellwerte zu verschiedenen Tageszeiten.
        Ein Multiplikator von 1.5 bedeutet z.B., dass Schwellwerte um 50% erhöht werden (lockerer).
    </p>

    <form asp-action="TimeProfiles" method="post">
        @Html.AntiForgeryToken()

        <div class="row">
            <!-- Business Hours -->
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-briefcase me-2"></i>Geschäftszeiten
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Zeitplan</label>
                            <input type="text" name="TimeProfiles.BusinessHours.Schedule"
                                   value="@Model.TimeProfiles.BusinessHours?.Schedule"
                                   class="form-control" placeholder="z.B. Mon-Fri 07:00-18:00" />
                            <div class="form-text">Format: Tag(e) Startzeit-Endzeit</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Schwellwert-Multiplikator</label>
                            <input type="number" name="TimeProfiles.BusinessHours.ThresholdMultiplier"
                                   value="@(Model.TimeProfiles.BusinessHours?.ThresholdMultiplier ?? 1.0)"
                                   class="form-control" step="0.1" min="0.5" max="3.0" />
                            <div class="form-text">1.0 = Normal, 1.5 = 50% lockerer</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Beschreibung</label>
                            <input type="text" name="TimeProfiles.BusinessHours.Description"
                                   value="@Model.TimeProfiles.BusinessHours?.Description"
                                   class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- After Hours -->
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-secondary text-white">
                        <i class="bi bi-moon me-2"></i>Außerhalb Geschäftszeiten
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Zeitplan</label>
                            <input type="text" name="TimeProfiles.AfterHours.Schedule"
                                   value="@Model.TimeProfiles.AfterHours?.Schedule"
                                   class="form-control" placeholder="z.B. Mon-Fri 18:00-07:00" />
                            <div class="form-text">Format: Tag(e) Startzeit-Endzeit</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Schwellwert-Multiplikator</label>
                            <input type="number" name="TimeProfiles.AfterHours.ThresholdMultiplier"
                                   value="@(Model.TimeProfiles.AfterHours?.ThresholdMultiplier ?? 1.5)"
                                   class="form-control" step="0.1" min="0.5" max="3.0" />
                            <div class="form-text">1.0 = Normal, 1.5 = 50% lockerer</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Beschreibung</label>
                            <input type="text" name="TimeProfiles.AfterHours.Description"
                                   value="@Model.TimeProfiles.AfterHours?.Description"
                                   class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weekend -->
            <div class="col-lg-6 col-xl-4 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <i class="bi bi-calendar-week me-2"></i>Wochenende
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Zeitplan</label>
                            <input type="text" name="TimeProfiles.Weekend.Schedule"
                                   value="@Model.TimeProfiles.Weekend?.Schedule"
                                   class="form-control" placeholder="z.B. Sat 00:00-24:00" />
                            <div class="form-text">Format: Tag(e) Startzeit-Endzeit</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Schwellwert-Multiplikator</label>
                            <input type="number" name="TimeProfiles.Weekend.ThresholdMultiplier"
                                   value="@(Model.TimeProfiles.Weekend?.ThresholdMultiplier ?? 2.0)"
                                   class="form-control" step="0.1" min="0.5" max="3.0" />
                            <div class="form-text">1.0 = Normal, 2.0 = 100% lockerer</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Beschreibung</label>
                            <input type="text" name="TimeProfiles.Weekend.Description"
                                   value="@Model.TimeProfiles.Weekend?.Description"
                                   class="form-control" placeholder="Optional" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>Zeitplan-Syntax
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Tage</h6>
                        <ul class="small">
                            <li><code>Mon</code>, <code>Tue</code>, <code>Wed</code>, <code>Thu</code>, <code>Fri</code>, <code>Sat</code>, <code>Sun</code></li>
                            <li><code>Mon-Fri</code> = Montag bis Freitag</li>
                            <li><code>Sat-Sun</code> = Wochenende</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>Zeit</h6>
                        <ul class="small">
                            <li>24-Stunden-Format: <code>HH:MM-HH:MM</code></li>
                            <li><code>07:00-18:00</code> = 7 Uhr bis 18 Uhr</li>
                            <li><code>18:00-07:00</code> = Über Mitternacht</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Zeitprofile speichern
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Zurück zu Einstellungen
            </a>
        </div>
    </form>
</div>
