                            <td><code>Server</code></td>
                            <td>Name des betroffenen Servers</td>
                        </tr>
                        <tr>
                            <td><code>Schweregrad</code></td>
                            <td>Critical (rot), Warning (orange) oder Info (blau)</td>
                        </tr>
                        <tr>
                            <td><code>Quelle</code></td>
                            <td>Welcher Check das Problem erkannt hat (z.B. CPU, Disk, EventLog)</td>
                        </tr>
                        <tr>
                            <td><code>Beschreibung</code></td>
                            <td>Details zum Problem</td>
                        </tr>
                        <tr>
                            <td><code>Seit</code></td>
                            <td>Zeitpunkt des ersten Auftretens</td>
                        </tr>
                        <tr>
