<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Minicon.SimpleAdmin</RootNamespace>
    <AssemblyName>Minicon.SimpleAdmin.HtmlGenerator</AssemblyName>
    <PackageId>Minicon.SimpleAdmin.HtmlGenerator</PackageId>
    <Version>2.27.0</Version>
    <Authors>Minicon Contributors</Authors>
    <Description>Static HTML generator that renders monitoring status pages for the Minicon SimpleAdmin monitoring platform.</Description>
    <PackageTags>monitoring;simpleadmin;html;static-pages</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Minicon.SimpleAdmin.Shared/Minicon.SimpleAdmin.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Services\documentation-template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
