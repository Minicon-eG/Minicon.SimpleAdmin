<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Minicon.SimpleAdmin</RootNamespace>
    <AssemblyName>Minicon.SimpleAdmin.Checkers</AssemblyName>
    <PackageId>Minicon.SimpleAdmin.Checkers</PackageId>
    <Version>2.36.0</Version>
    <Authors>Minicon Contributors</Authors>
    <Description>AppPool, Windows service, event log, certificate, SQL and email checkers for the Minicon SimpleAdmin monitoring platform.</Description>
    <PackageTags>monitoring;simpleadmin;checkers;iis;sql;email</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Minicon.SimpleAdmin.Shared/Minicon.SimpleAdmin.Shared.csproj" />
    <ProjectReference Include="../Minicon.SimpleAdmin.Services/Minicon.SimpleAdmin.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit pulls System.Security.Cryptography.Pkcs 10.0.0 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) — pin the patched version -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
