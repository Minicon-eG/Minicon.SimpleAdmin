<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Minicon.SimpleAdmin</RootNamespace>
    <AssemblyName>Minicon.SimpleAdmin.Services</AssemblyName>
    <PackageId>Minicon.SimpleAdmin.Services</PackageId>
    <Version>2.30.0</Version>
    <Authors>Minicon Contributors</Authors>
    <Description>Platform metrics, status evaluation and runtime status persistence services for the Minicon SimpleAdmin monitoring platform.</Description>
    <PackageTags>monitoring;simpleadmin;services;metrics;platform</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Minicon.SimpleAdmin.Shared/Minicon.SimpleAdmin.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.8" />
  </ItemGroup>

</Project>
